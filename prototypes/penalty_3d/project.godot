; Standalone Godot prototype. Import this file in the Standard editor.
config_version=5

[application]
config/name="One-Touch Striker - 3D Arena"
config/description="A five-ball 3D penalty prototype."
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.4", "GL Compatibility")
config/icon="res://icon.png"
config/quit_on_go_back=false

[display]
window/size/viewport_width=400
window/size/viewport_height=800
window/size/window_width_override=480
window/size/window_height_override=960
window/stretch/mode="canvas_items"
window/handheld/orientation=1

[input_devices]
pointing/emulate_touch_from_mouse=false
pointing/emulate_mouse_from_touch=false

[physics]
common/physics_ticks_per_second=60
common/physics_interpolation=true

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
anti_aliasing/quality/msaa_3d=1
environment/defaults/default_clear_color=Color(0.025, 0.08, 0.105, 1)
